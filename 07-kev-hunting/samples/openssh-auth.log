# Addresses are documentation ranges (RFC 5737) only. Hostname is ssh.example.com.
# sshd does not record the password or the shadow field. The INVENTORY lines are
# the stand-in for a per-host account census: the password field only, never a hash.
# INVENTORY password_field=* : alpine root
